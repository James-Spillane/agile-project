<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Display Page</title>
    <link rel="stylesheet" href="/styles.css">
    <script>
        function validateForm() {
            // Get the form inputs
            const cardNumber = document.forms["bookingForm"]["cardNumber"].value;
            const expiry = document.forms["bookingForm"]["expiry"].value;
            const securityCode = document.forms["bookingForm"]["securityCode"].value;
            
            // Here I put Validation, if cardNumber, expiry, and securityCode are anything
            // but numbers there be an error at the top of the page
            // Validate card number format and digits, - between mm and yy
            const cardNumberDigits = cardNumber.replace(/-/g, '');
            if (!/^\d{16}$/.test(cardNumberDigits)) { 
                alert("Card number must be a valid 16-digit number."); 
                return false; // stops form from being submitted }
            }
            const expiryMatch = expiry.match(/^(\d{2})-(\d{2})$/);
            
            if (!expiryMatch) {
                alert("Expiry date must be in the format MM-YY.");
                return false; // Stops form from being submitted
            }
        
            if (isNaN(securityCode) || securityCode === "") {
                alert("Security code must be a valid number.");
                return false; //stops form for being submitted
            }

            return true; // the form will be submitted.
        }
    </script>
</head>
<body>

    <h1>Modify Booking</h1>
    <%- include('partials/header') %>
    <form action="/update/<%= booking._id %>" method="POST" name ="bookingForm" onsubmit="return validateForm()">
        <label>Name: <input type="text" name="name" value="<%= booking.name %>" required></label><br>
        <label>User ID: <input type="text" name="userId" value="<%= booking.userId %>" required></label><br>
        <label>Session Date & Time: <input type="datetime-local" name="dateTime" value="<%= booking.dateTime ? booking.dateTime.toISOString().slice(0,16) : '' %>" required></label><br>
        <label>Card Number: <input type="text" name="cardNumber" value="<%= booking.cardNumber %>" maxlength="19" minlength="19"required></label><br>
        <label>Expiry Date: <input type="text" name="expiry" value="<%= booking.expiryDate %>" required></label><br>
        <label>Security Code: <input type="text" name="securityCode" value="<%= booking.securityCode %>"maxlength="3" minlength="3" required></label><br>
        <button type="submit">Update Booking</button>
        
    </form>
    <%- include('partials/footer') %>
</body>
</html>
