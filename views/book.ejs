<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/css/style.css" />
  <script>
    function validateForm() {
      const f = document.forms["bookingForm"];
      const cardNumber = f["cardNumber"].value;
      const expiry = f["expiry"].value;
      const securityCode = f["securityCode"].value;

      const cardNumberDigits = cardNumber.replace(/-/g, '');
      if (!/^\d{16}$/.test(cardNumberDigits)) {
        alert("Card number must be a valid 16-digit number.");
        return false;
      }
      const expiryMatch = expiry.match(/^(\d{2})-(\d{2})$/);
      if (!expiryMatch) {
        alert("Expiry date must be in the format MM-YY.");
        return false;
      }
      if (!/^\d{3}$/.test(securityCode)) {
        alert("Security code must be a valid 3-digit number.");
        return false;
      }
      return true;
    }
  </script>
</head>

<body>
  <header>
    <h1>Welcome to Blink</h1>
    <p>Your cozy companion for mindful screen time</p>
    <div class="mascot">🐻</div>
    <nav class="navbar">
      <a href="/">🏠 Home</a> |
      <a href="/about">About</a> |
      <a href="/screen-time">Screentime</a> |
      <a href="/help">Help</a>
    </nav>
  </header>

  <section class="intro">
    <p>Track your habits, earn cute badges, and give your brain a bubble bath 🛁</p>
    <a href="/book" class="start-btn">Sign Up</a>
  </section>

  <main class="grid">
    <!-- Booking form -->
    <section class="card">
      <h2>Book a Session</h2>
      <form action="/book" method="POST" name="bookingForm" onsubmit="return validateForm()">
        <label>Name</label>
        <input type="text" name="name" required>

        <label>User ID (10 characters)</label>
        <input type="text" name="userId" maxlength="10" minlength="10" required>

        <label>Training Date and Time</label>
        <input type="datetime-local" name="dateTime" required>

        <h3>Payment Details (demo only)</h3>
        <label>Card Number</label>
        <input type="text" placeholder="1234-5678-9012-3456">

        <label>Expiry (MM-YY)</label>
        <input type="text" placeholder="MM-YY">

        <label>Security Code</label>
        <input type="text" maxlength="3" minlength="3">

        <!-- Optionally a checkbox to simulate payment -->
        <label><input type="checkbox" name="paid" value="true"> Mark as paid (demo)</label>

        <button type="submit">Submit Booking</button>
      </form>
    </section>

    <!-- Login form -->
    <section class="card">
      <h2>Login</h2>
      <form action="/login" method="POST" novalidate>
        <label for="email">Email or Username</label>
        <input type="text" id="email" name="email" required>

        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>

        <button type="submit">Login</button>
      </form>
    </section>
  </main>

  <footer>
    <p>&copy; 2025 Mindful Screen Time App</p>
  </footer>
</body>
</html>
